{
  "name": "webappsec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:verifier": "node scripts/build-verifier.mjs",
    "snapshot:resolve": "node scripts/resolve-online-verifier.mjs",
    "deploy:validate": "npm run build && XDG_CONFIG_HOME=.artifacts/xdg WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir .artifacts/wrangler-dry-run",
    "deploy:verifier:validate": "npm run build:verifier && XDG_CONFIG_HOME=.artifacts/xdg WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.verifier.jsonc --outdir .artifacts/wrangler-verifier-dry-run",
    "deploy:verifier:package:validate": "XDG_CONFIG_HOME=.artifacts/xdg WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.verifier.jsonc --outdir .artifacts/wrangler-verifier-package-dry-run",
    "tools:evidence": "tools/install-evidence-tools.sh .bin",
    "evidence:generate": "node scripts/generate-evidence.mjs",
    "evidence:assemble": "node scripts/assemble-release.mjs build",
    "evidence:verify": "node scripts/assemble-release.mjs verify",
    "tools:signing": "tools/install-cosign.sh .bin",
    "verify": "node scripts/verify-production.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "artifact:verify": "node scripts/release-artifact.mjs verify",
    "artifact:verify-tar": "node scripts/release-artifact.mjs verify-tar",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "check": "npm run test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "parse5": "8.0.1",
    "wrangler": "4.151.3"
  }
}
