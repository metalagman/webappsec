{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webappsec.metalagman.dev/schema/deployment-manifest-v1",
  "title": "Webappsec deployment manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "origin", "release", "worker", "inputs", "files"],
  "properties": {
    "schema": { "const": "https://webappsec.metalagman.dev/schema/deployment-manifest-v1" },
    "version": { "const": 1 },
    "origin": { "const": "https://webappsec.metalagman.dev" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tag", "workflow"],
      "properties": {
        "repository": { "const": "https://github.com/metalagman/webappsec" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" },
        "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "const": "webappsec" } }
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/input" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "const": "worker/index.js" },
              "role": { "const": "worker" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "const": "wrangler.jsonc" },
              "role": { "const": "configuration" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" },
      "contains": {
        "type": "object",
        "required": ["path", "urlPath"],
        "properties": {
          "path": { "const": "assets/index.html" },
          "urlPath": { "const": "/" }
        }
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,239}$" },
        "role": { "enum": ["worker", "configuration"] },
        "size": { "type": "integer", "minimum": 0, "maximum": 26214400 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "urlPath", "mediaType", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^assets/(?!.*(?:^|/)\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,232}$" },
        "urlPath": { "type": "string", "pattern": "^/(?!/)(?!.*(?:\\.\\.|%|\\\\|\\?|#))[A-Za-z0-9._/-]*$" },
        "mediaType": {
          "enum": [
            "application/json; charset=utf-8",
            "application/octet-stream",
            "image/svg+xml",
            "text/css; charset=utf-8",
            "text/html; charset=utf-8",
            "text/javascript; charset=utf-8"
          ]
        },
        "size": { "type": "integer", "minimum": 0, "maximum": 26214400 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
