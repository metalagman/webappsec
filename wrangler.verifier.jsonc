{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webappsec-verifier",
  "main": "./verifier-worker/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist-verifier",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "verify.webappsec.metalagman.dev",
      "custom_domain": true
    }
  ]
}
